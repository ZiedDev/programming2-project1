@startuml MarsOps_Facility_Class_Diagram

skinparam monochrome false
skinparam classFontStyle bold
skinparam linetype ortho
skinparam packageStyle rectangle

title MarsOps - Facility & Facility Management Class Diagram

package "marsops.colony" {
    class FacilityManager {
        - facilityList: List<Facility>
        + addFacility(x: Facility): void
        + getFacilities(): List<Facility>
        + getTotalResources(): Map<ResourceType, Integer>
        + getTotalEquipment(): int
        + canProvide(mission: Mission): boolean
        + canProvide(emergency: Emergency): boolean
        - canProvide(requiredResources: Map<ResourceType, Integer>, requiredEquipment: int): boolean
        + provide(emergency: Emergency): void
        + provide(mission: Mission): void
        - provide(requiredResources: Map<ResourceType, Integer>, requiredEquipment: int): void
    }
}

package "marsops.facility" {

    abstract class Location {
        # location: String
        + Location(location: String)
    }

    class SurfaceLocation extends Location {
        + SurfaceLocation(location: String)
    }

    abstract class Facility extends Location {
        - capacity: int
        - resourceAmount: Map<ResourceType, Integer>
        - equipmentList: List<Equipment>
        - id: int
        - {static} cnt: int = 0
        - isAvailable: boolean
        - totalTakenCapacity: int = 0
        # prioToAllocate: ResourceType[7]
        + Facility(location: String, capacity: int)
        + setAvailability(state: boolean): void
        + isAvailable(): boolean
        + getResources(): Map<ResourceType, Integer>
        + getEquipment(): List<Equipment>
        + getEquipmentCount(): int
        + getTotalTakenCapacity(): int
        + addEquipment(): boolean
        + deductEquipment(amount: int): int
        + addResources(resourcesToAllocate: Map<ResourceType, Integer>): Map<ResourceType, Integer>
        + deductResource(amount: int, resource: ResourceType): int
    }
together{
    class Habitat extends Facility {
        + Habitat(location: String, capacity: int)
    }

    class Laboratory extends Facility {
        + Laboratory(location: String, capacity: int)
    }

    class PowerStation extends Facility {
        + PowerStation(location: String, capacity: int)
    }

    class StorageFacility extends Facility {
        + StorageFacility(location: String, capacity: int)
    }

    class CommunicationStation extends Facility {
        + CommunicationStation(location: String, capacity: int)
    }
  }
}

package "marsops.resource" {
    class Equipment {
        - isDamaged: Boolean
        - {static} cnt: int = 0
        - id: int
        - location: Location
        + Equipment(location: Location)
        + isAvailable(): boolean
        + fix(): void
        + damage(): void
    }

    enum ResourceType {
        OXYGEN
        WATER
        FOOD
        FUEL
        BATTERY
        MEDICAL
        SPARE_PARTS
    }

    class ResourceAllocationPolicy {
        - {static} PRIORITY: Map<ResourceType, List<Class<? extends Facility>>>
        - {static} DEFAULT_PRIORITY: List<Class<? extends Facility>>
        - ResourceAllocationPolicy()
        + {static} getPriority(resourceType: ResourceType): List<Class<? extends Facility>>
        + {static} getEquipmentPriority(): List<Class<? extends Facility>>
    }
}

package "marsops.mission" {
    class Mission
}

package "marsops.emergency" {
    class Emergency
}


' --- RELATIONSHIPS ---
FacilityManager o-- "0..*" Facility : manages / facilityList >
FacilityManager ..> ResourceAllocationPolicy : uses >
FacilityManager ..> Mission : checks / provides for >
FacilityManager ..> Emergency : checks / provides for >

Facility o-- "0..*" Equipment 
Facility ..> ResourceType 

@enduml
