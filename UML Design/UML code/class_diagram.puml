@startuml MarsOps_Facility_Class_Diagram

skinparam monochrome false
skinparam classFontStyle bold
skinparam linetype ortho
skinparam packageStyle rectangle

top to bottom direction

package "marsops.colony" {
    enum Environment {
        NORMAL
        DUST_STORM
        COMM_DISRUPTION
    }
    class Colony {
        - activeMission: Mission
        - environment: Environment
        - pastMissions: List<Mission> {readOnly}
        - pastEmergencies: List<Emergency> {readOnly}
        - agentManager: AgentManager {readOnly}
        - facilityManager: FacilityManager {readOnly}
        - printManager: PrintManager {readOnly}
        + submitMission(mission: Mission): boolean
        - rejectMission(mission: Mission, reason: String): void
        - addCompletedMission(mission: Mission): void
        + submitEmergency(emergency: Emergency): boolean
        - rejectEmergency(emergency: Emergency, reason: String): void
        + advanceTime(timeUnit: int): void
        + getActiveMission(): Mission
        + getPastMissions(): List<Mission>
        + getPastEmergencies(): List<Emergency>
    }

    class FacilityManager {
        - facilityList: List<Facility>
        + addFacility(x: Facility): void
        + getFacilities(): List<Facility>
        + getTotalResources(): Map<ResourceType, Integer>
        + getTotalEquipment(): int
        + canProvide(mission: Mission): boolean
        + canProvide(emergency: Emergency): boolean
        - canProvide(requiredResources: Map<ResourceType, Integer>, requiredEquipment: int): boolean
        + provide(emergency: Emergency): void
        + provide(mission: Mission): void
        - provide(requiredResources: Map<ResourceType, Integer>, requiredEquipment: int): void
    }
    
    class AgentManager {
        - {static} agents: ArrayList<Agent> {readOnly}
        - {static} agentsCount: Map<Class<? extends Agent>, Integer> {readOnly}
        - register<T : Agent>(agent: T): T
        + createAgent(type: Class<? extends Human>, originLocation: Facility, name: String, id: String): Human
        + createAgent(type: Class<? extends Robot>, originLocation: Facility): Robot
        + addAgent(agent: Agent): void
        + getAgents(): ArrayList<Agent>
        + canProvide(mission: Mission): boolean
        + canProvide(emergency: Emergency): boolean
        + provide(mission: Mission): ArrayList<Agent>
        + release(mission: Mission): void
        + rescue(mission: Mission): void
        + relocate(agent: Agent, location: Location): void
        + relocate(agents: ArrayList<Agent>, location: Location): void
        + advanceTime(timeUnit: int): void
    }
    class PrintManager {
        + printMissionOutcome(mission: Mission): void
        + printMissionAndEmergencyOutcomes(): void
    }

    FacilityManager -[hidden]right- AgentManager
}

package "marsops.mission" {
    class Mission
}

package "marsops.facility" {
    abstract class Location {
        # location: String
        + Location(location: String)
    }

    class SurfaceLocation extends Location {
        + SurfaceLocation(location: String)
    }

    abstract class Facility extends Location {
        - capacity: int
        - resourceAmount: Map<ResourceType, Integer>
        - equipmentList: List<Equipment>
        - id: int
        - {static} cnt: int = 0
        - isAvailable: boolean
        - totalTakenCapacity: int = 0
        # prioToAllocate: ResourceType[7]
        + Facility(location: String, capacity: int)
        + setAvailability(state: boolean): void
        + isAvailable(): boolean
        + getResources(): Map<ResourceType, Integer>
        + getEquipment(): List<Equipment>
        + getEquipmentCount(): int
        + getTotalTakenCapacity(): int
        + addEquipment(): boolean
        + deductEquipment(amount: int): int
        + addResources(resourcesToAllocate: Map<ResourceType, Integer>): Map<ResourceType, Integer>
        + deductResource(amount: int, resource: ResourceType): int
    }

    together {
        class Habitat extends Facility {
            + Habitat(location: String, capacity: int)
        }
        class Laboratory extends Facility {
            + Laboratory(location: String, capacity: int)
        }
        class PowerStation extends Facility {
            + PowerStation(location: String, capacity: int)
        }
        class StorageFacility extends Facility {
            + StorageFacility(location: String, capacity: int)
        }
        class CommunicationStation extends Facility {
            + CommunicationStation(location: String, capacity: int)
        }
    }
}

package "marsops.resource" {
    class Equipment {
        - isDamaged: Boolean
        - {static} cnt: int = 0
        - id: int
        - location: Location
        + Equipment(location: Location)
        + isAvailable(): boolean
        + fix(): void
        + damage(): void
    }

    enum ResourceType {
        OXYGEN
        WATER
        FOOD
        FUEL
        BATTERY
        MEDICAL
        SPARE_PARTS
    }

    class ResourceAllocationPolicy {
        - {static} PRIORITY: Map<ResourceType, List<Class<? extends Facility>>>
        - {static} DEFAULT_PRIORITY: List<Class<? extends Facility>>
        - ResourceAllocationPolicy()
        + {static} getPriority(resourceType: ResourceType): List<Class<? extends Facility>>
        + {static} getEquipmentPriority(): List<Class<? extends Facility>>
    }
}

package "marsops.agent" {
    abstract class Agent {
        - originLocation: Facility {readOnly}
        - currentLocation: Location
        - isAvailable: boolean
        - health: int
        - assignedMission: Mission
        + setAvailable(available: boolean): void
        + setAssignedMission(assignedMission: Mission): void
        + getCurrentLocation(): Location
        + isAvailable(): boolean
        + getAssignedMission(): Mission
        + canPerform(mission: Mission): boolean
        + canHandle(emergency: Emergency): boolean
    }

    abstract class Human extends Agent {
        - {static} FATIGUE_MAX: int = 100 {readOnly}
        - {static} FATIGUE_MIN: int = 0 {readOnly}
        - id: String {readOnly}
        - name: String {readOnly}
        - fatigue: int
        + reduceFatigue(timeUnit: int): void
        + increaseFatigue(timeUnit: int): void
        + updateFatigue(timeUnit: int): void
        + canPerform(mission: Mission): boolean
        + canHandle(emergency: Emergency): boolean
        + advanceTime(timeUnit: int): void
    }

    class Engineer extends Human {
        + canPerform(mission: Mission): boolean
    }

    class MedicalOfficer extends Human {
        + canPerform(mission: Mission): boolean
    }

    class Scientist extends Human {
        + canPerform(mission: Mission): boolean
    }

    abstract class Robot extends Agent {
        - {static} BATTERY_LEVEL_MAX: int = 100 {readOnly}
        - {static} BATTERY_LEVEL_MIN: int = 0 {readOnly}
        - batteryLevel: int
        + reduceBatteryLevel(timeUnit: int): void
        + increaseBatteryLevel(timeUnit: int): void
        + updateBatteryLevel(timeUnit: int): void
        + canPerform(mission: Mission): boolean
        + canHandle(emergency: Emergency): boolean
        + advanceTime(timeUnit: int): void
    }

    class Drone extends Robot {
        + canPerform(mission: Mission): boolean
    }

    class ExplorationRover extends Robot {
        + canPerform(mission: Mission): boolean
    }

    class RepairRobot extends Robot {
        + canPerform(mission: Mission): boolean
    }
}

package "marsops.emergency" {

    enum EmergencyStatus {
        RESOLVED
        UNRESOLVED
    }

    abstract class Emergency {
        # status: EmergencyStatus
        # failureReason: String
        # location: Location
        # requiredAgents: Map<Class<? extends Agent>, Integer>
        # requiredResources: Map<ResourceType, Integer>
        + Emergency(location: Location)
        + {abstract} validateRequirements(): boolean
        + getFailureReason(): String
        + resolve(): void
        + fail(reason: String): void
        + getRequiredAgents(): Map<Class<? extends Agent>, Integer>
        + getRequiredResources(): Map<ResourceType, Integer>
        + addRequiredResource(type: ResourceType, amount: int): void
    }

    together {
        class OxygenLeakEmergency extends Emergency {
            - affectedHabitat: Habitat
            - oxygenLoss: int
            + OxygenLeakEmergency(affectedHabitat: Habitat, oxygenLoss: int, requiredEngineerCount: int, requiredRepairBotCount: int, requiredSparePartsCount: int)
            - applyOxygenLoss(): void
            + validateRequirements(): boolean
            + fail(reason: String): void
        }

        class FireEmergency extends Emergency {
            - affectedLaboratory: Laboratory
            + FireEmergency(affectedLaboratory: Laboratory, requiredWaterCount: int, requiredMedicalSuppliesCount: int)
            + validateRequirements(): boolean
            + fail(reason: String): void
        }

        class RoverBreakdownEmergency extends Emergency {
            - damagedRover: ExplorationRover
            + RoverBreakdownEmergency(damagedRover: ExplorationRover, requiredSparePartsCount: int)
            + validateRequirements(): boolean
            + resolve(): void
        }

        class MedicalEmergency extends Emergency {
            - patient: Human
            - treatmentFacility: Facility
            + MedicalEmergency(patient: Human, treatmentFacility: Facility, requiredMedicalSuppliesCount: int)
            + validateRequirements(): boolean
            + resolve(): void
        }
    }
}


package "marsops.mission" {

    enum MissionStatus {
        ASSIGNED
        IN_PROGRESS
        COMPLETED
        FAILED
        - value: String {readOnly}
        ~ MissionStatus(value: String)
        + toString(): String
    }

    abstract class Mission {
        - duration: int {readOnly}
        - elapsed: int
        # requiredEquipment: int
        - isCommunicationDependent: boolean
        - status: MissionStatus
        # failureReason: String
        - requiredResources: Map<ResourceType, Integer> {readOnly}
        # requiredAgents: Map<Class<? extends Agent>, Integer> {readOnly}
        - assignedAgents: ArrayList<Agent>
        # targetLocation: Location
        # targetAgent: Agent
        + Mission(duration: int)
        + {abstract} validateRequirements(): boolean
        + assignAgents(agents: ArrayList<Agent>): void
        + tick(timeUnits: int): void
        + complete(): void
        + fail(reason: String): void
        + getDuration(): int
        + getElapsed(): int
        + getEquipmentCount(): int
        + isCommunicationDependent(): boolean
        + setCommunicationDependent(isCommunicationDependent: boolean): void
        + getStatus(): MissionStatus
        + setStatus(status: MissionStatus): void
        + getFailureReason(): String
        + getTargetLocation(): Location
        + getTargetAgent(): Agent
        + getRequiredResources(): Map<ResourceType, Integer>
        + getRequiredAgents(): Map<Class<? extends Agent>, Integer>
        + getAssignedAgents(): ArrayList<Agent>
        + addRequiredResource(type: ResourceType, amount: int): void
        + addRequiredAgent(type: Class<? extends Agent>, amount: int): void
        + addRequiredEquipment(amount: int): void
    }

    together {
        class ExplorationMission extends Mission {
            - region: String {readOnly}
            + ExplorationMission(duration: int, region: String, requiredRoverCount: int, requiredScientistCount: int, requiredBatteryCount: int, requiredEquipmentCount: int, requiredFuel: int, requiredOxygen: int, requiredWater: int, requiredFood: int)
            + validateRequirements(): boolean
            + getRegion(): String
        }

        class RepairMission extends Mission {
            - damagedFacility: Facility {readOnly}
            - damagedEquipment: Equipment {readOnly}
            + RepairMission(duration: int, damagedFacility: Facility, requiredEngineerCount: int, requiredRepairBotCount: int, requiredBatteryCount: int, requiredSparePartsCount: int)
            + RepairMission(duration: int, damagedEquipment: Equipment, requiredEngineerCount: int, requiredRepairBotCount: int, requiredBatteryCount: int, requiredSparePartsCount: int)
            + validateRequirements(): boolean
            + complete(): void
            + getDamagedFacility(): Facility
            + getDamagedEquipment(): Equipment
        }

        class ResearchMission extends Mission {
            - laboratory: Laboratory {readOnly}
            + ResearchMission(duration: int, laboratory: Laboratory, requiredScientistCount: int, requiredBatteryCount: int, requiredSparePartsCount: int, requiredEquipmentCount: int)
            + validateRequirements(): boolean
            + getLaboratory(): Laboratory
        }

        class RescueMission extends Mission {
            - strandedAgent: Agent {readOnly}
            + RescueMission(duration: int, strandedAgent: Agent, requiredRoverCount: int, requiredMedicalOfficerCount: int, requiredMedicalSuppliesCount: int, requiredFuelCount: int)
            + RescueMission(duration: int, targetRegion: String, requiredRoverCount: int, requiredMedicalOfficerCount: int, requiredMedicalSuppliesCount: int, requiredFuelCount: int)
            + validateRequirements(): boolean
            + getStrandedAgent(): Agent
        }
    }
}

