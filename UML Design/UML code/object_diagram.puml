@startuml MarsOps_Object_Diagram

skinparam monochrome false
skinparam shadowing false
skinparam roundCorner 8
skinparam linetype ortho
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam objectFontSize 11
skinparam objectFontStyle bold
skinparam arrowFontSize 10
skinparam arrowThickness 1.2
skinparam arrowColor #37474F

title MARS-OPS Object Diagram - System Snapshot\n(State: Immediately Before Exploration Mission Execution, Following Resolved Oxygen Leak)

legend top left
  <b>Snapshot Context & Timing:</b>
  • <b>Preceding Event:</b> oxygenLeakEmergency resolved by engineer and repairRboot, explorationMission just got accepted and assigned a scientist and a repairbot (elapsed 0 time) and required resources and equipment allocated.
  • <b>agents:</b> rover1 and scientist1 assigned to a mission.
endlegend

package "Colony Management Tier" #ECEFF1 {
    object "colony : Colony" as colony #CFD8DC {
        environment = Environment.NORMAL
        activeMission = mission1
        pastMissions = []
        pastEmergencies = [leak1]
    }

    object "agentMgr : AgentManager" as agentMgr #ECEFF1 {
        agents = [scientist1, engineer1, rover1, repairBot1]
        groupedAgents = 4 agent classes registered
    }

    object "facilityMgr : FacilityManager" as facilityMgr #ECEFF1 {
        facilityList = [habitat1, storage1]
    }

    object "printMgr : PrintManager" as printMgr #ECEFF1
}

package "Active Mission & Target Location" #FFF9C4 {
    object "mission1 : ExplorationMission" as mission1 #FFF59D {
        region = "mars surface"
        duration = 2
        elapsed = 0
        status = MissionStatus.ASSIGNED
        failureReason = ""
        isCommunicationDependent = false
        requiredEquipment = 1
        requiredAgents = {ExplorationRover: 1, Scientist: 1}
        requiredResources = {BATTERY: 10, FUEL: 10, OXYGEN: 10, WATER: 5, FOOD: 5}
    }

    object "surfaceLoc1 : SurfaceLocation" as surfaceLoc1 #FFFDE7 {
        location = "mars surface"
    }
}

package "Colony Facilities & Equipment" #E8F5E9 {
    object "habitat1 : Habitat" as habitat1 #C8E6C9 {
        id = 1
        location = "Shibuya Sector A"
        capacity = 400
        totalTakenCapacity = 330
        isAvailable = true
        resourceAmount = {OXYGEN: 40, WATER: 95, FOOD: 95, MEDICAL: 100}
        equipmentList = [equipment2]
    }

    object "storage1 : StorageFacility" as storage1 #C8E6C9 {
        id = 2
        location = "Smouha Sector B"
        capacity = 300
        totalTakenCapacity = 280
        isAvailable = true
        resourceAmount = {BATTERY: 90, FUEL: 90, SPARE_PARTS: 100}
    }

    object "equipment2 : Equipment" as equipment2 #DCEDC8 {
        id = 1
        isDamaged = false
    }
}

package "Human Crew Personnel" #FFE0B2 {
    object "scientist1 : Scientist" as scientist1 #FFCC80 {
        name = "Hesham"
        id = "10062"
        health = 100
        fatigue = 0
        isAvailable = false
    }

    object "engineer1 : Engineer" as engineer1 #FFE0B2 {
        name = "Hossam"
        id = "10010"
        health = 100
        fatigue = 0
        isAvailable = true
    }
}

package "Autonomous Robotic Units" #E0F7FA {
    object "rover1 : ExplorationRover" as rover1 #80DEEA {
        batteryLevel = 100
        health = 100
        isAvailable = false
    }

    object "repairBot1 : RepairRobot" as repairBot1 #B2EBF2 {
        batteryLevel = 100
        health = 100
        isAvailable = true
    }
}

package "Past Resolved Emergencies" #FFEBEE {
    object "leak1 : OxygenLeakEmergency" as leak1 #FFCDD2 {
        status = EmergencyStatus.RESOLVED
        failureReason = ""
        oxygenLoss = 50
        requiredAgents = {Engineer: 1, RepairRobot: 1}
        requiredResources = {SPARE_PARTS: 2}
        affectedHabitat = habitat1
    }
}

' --- Structural Links within Colony Management ---
colony -- agentMgr : agentManager
colony -- facilityMgr : facilityManager
colony -- printMgr : printManager

' --- Mission Links ---
colony -- mission1 : activeMission
mission1 -- surfaceLoc1 : targetLocation
mission1 -- rover1 : assignedAgents[0]
mission1 -- scientist1 : assignedAgents[1]

' --- Agent State Links ---
rover1 -- mission1 : assignedMission
scientist1 -- mission1 : assignedMission
rover1 -- surfaceLoc1 : currentLocation
scientist1 -- surfaceLoc1 : currentLocation
rover1 -- habitat1 : originLocation
scientist1 -- habitat1 : originLocation

engineer1 -- habitat1 : originLocation & currentLocation
repairBot1 -- storage1 : originLocation & currentLocation

' --- Facility & Equipment Links ---
facilityMgr -- habitat1 : facilityList[0]
facilityMgr -- storage1 : facilityList[1]
storage1 -- equipment2 : equipmentList[0]
equipment2 -- storage1 : location

' --- AgentManager Registry Links ---
agentMgr -- scientist1 : agents[0]
agentMgr -- engineer1 : agents[1]
agentMgr -- rover1 : agents[2]
agentMgr -- repairBot1 : agents[3]

' --- Emergency Links ---
colony -- leak1 : pastEmergencies[0]
leak1 -- habitat1 : affectedHabitat & location

@enduml
