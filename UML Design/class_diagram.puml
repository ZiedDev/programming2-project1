@startuml MARS_OPS_Class_Diagram
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam classFontStyle bold
skinparam linetype ortho

title MARS-OPS Class Diagram (Static Structure)

' --- ENUMERATIONS ---
enum Environment {
    NORMAL
    DUST_STORM
    COMM_DISRUPTION
}

enum MissionStatus {
    ASSIGNED
    IN_PROGRESS
    COMPLETED
    FAILED
}

enum EmergencyStatus {
    RESOLVED
    UNRESOLVED
}

enum ResourceType {
    OXYGEN
    WATER
    FOOD
    FUEL
    BATTERY
    MEDICAL
    SPARE_PARTS
}

enum EmergencyType {
    OXYGEN_LEAK
    FIRE
    ROVER_BREAKDOWN
    MEDICAL_EMERGENCY
}

' --- EQUIPMENT ---
class Equipment {
    - isDamaged: boolean
    + isDamaged(): boolean
    + setDamaged(damaged: boolean): void
}

' --- COLONY CORE & COMPOSITION ---
class Colony {
    - environment: Environment
    - activeMission: Mission
    - pastMissions: List<Mission>
    - pastEmergencies: List<Emergency>
    - printManager: PrintManager
    + submitMission(mission: Mission, agents: List<Agent>): boolean
    + handleEmergency(emergency: Emergency): boolean
    + advanceTime(units: int): void
    + getTotalResource(type: ResourceType): int
    + consumeResources(req: Map<ResourceType, Integer>): boolean
    + getFacilities(): List<Facility>
    + getAgents(): List<Agent>
}

class PrintManager {
    - colony: Colony
    + printStatusReport(): void
    + printResourceTotals(): void
    + printEnvironmentStatus(): void
    + printMissionHistory(): void
    + printEmergencyHistory(): void
}

' --- FACILITIES ---
abstract class Facility {
    # location: String
    # capacity: int
    # isOperational: boolean
    # resources: Map<ResourceType, Integer>
    + isOperational(): boolean
    + setOperational(operational: boolean): void
    + getResource(type: ResourceType): int
    + addResource(type: ResourceType, amount: int): void
    + deductResource(type: ResourceType, amount: int): boolean
    + getEquipmentList(): List<Equipment>
}

class Habitat extends Facility {
}

class Laboratory extends Facility {
}

class StorageFacility extends Facility {
}

class PowerStation extends Facility {
}

class CommunicationStation extends Facility {
}

' --- AGENTS ---
abstract class Agent {
    # name: String
    # id: String
    # currentLocation: String
    # isAvailable: boolean
    # health: int
    + {abstract} canPerform(mission: Mission): boolean
    + {abstract} canHandle(emergency: Emergency): boolean
    + isAvailable(): boolean
    + setAvailable(available: boolean): void
    + getCurrentLocation(): String
    + setCurrentLocation(location: String): void
    + getHealth(): int
    + setHealth(health: int): void
}

abstract class Human extends Agent {
    # fatigue: int
    # skills: List<String>
    + getFatigue(): int
    + setFatigue(fatigue: int): void
    + getSkills(): List<String>
}

class Scientist extends Human {
    + canPerform(mission: Mission): boolean
    + canHandle(emergency: Emergency): boolean
}

class Engineer extends Human {
    + canPerform(mission: Mission): boolean
    + canHandle(emergency: Emergency): boolean
    + repair(equipment: Equipment): void
}

class MedicalOfficer extends Human {
    + canPerform(mission: Mission): boolean
    + canHandle(emergency: Emergency): boolean
    + treatPatient(patient: Human): void
}

abstract class RobotUnit extends Agent {
    # batteryLevel: int
    + getBatteryLevel(): int
    + consumeBattery(amount: int): void
    + recharge(amount: int): void
}

class ExplorationRover extends RobotUnit {
    + canPerform(mission: Mission): boolean
    + canHandle(emergency: Emergency): boolean
}

class RepairRobot extends RobotUnit {
    + canPerform(mission: Mission): boolean
    + canHandle(emergency: Emergency): boolean
}

class Drone extends RobotUnit {
    + canPerform(mission: Mission): boolean
    + canHandle(emergency: Emergency): boolean
}

' --- MISSIONS ---
abstract class Mission {
    # duration: int
    # elapsed: int
    # isCommunicationDependent: boolean
    # status: MissionStatus
    # failureReason: String
    # requiredResources: Map<ResourceType, Integer>
    # assignedAgents: List<Agent>
    + {abstract} validateRequirements(agents: List<Agent>): boolean
    + tick(timeUnits: int): void
    + complete(): void
    + fail(reason: String): void
    + getStatus(): MissionStatus
    + getAssignedAgents(): List<Agent>
}

class ExplorationMission extends Mission {
    - region: String
    - requiredBattery: int
    + validateRequirements(agents: List<Agent>): boolean
}

class RepairMission extends Mission {
    - damagedFacility: Facility
    - damagedEquipment: Equipment
    + validateRequirements(agents: List<Agent>): boolean
}

class ResearchMission extends Mission {
    - targetLab: Laboratory
    + validateRequirements(agents: List<Agent>): boolean
}

class RescueMission extends Mission {
    - targetLocation: String
    + validateRequirements(agents: List<Agent>): boolean
}

' --- EMERGENCIES ---
abstract class Emergency {
    # emergencyType: EmergencyType
    # location: String
    # status: EmergencyStatus
    # failureReason: String
    # requiredResources: Map<ResourceType, Integer>
    # assignedResponders: List<Agent>
    + {abstract} handle(colony: Colony): boolean
    + getStatus(): EmergencyStatus
    + getFailureReason(): String
}

class OxygenLeakEmergency extends Emergency {
    - affectedHabitat: Habitat
    - oxygenLoss: int
    + handle(colony: Colony): boolean
}

class FireEmergency extends Emergency {
    - affectedFacility: Facility
    + handle(colony: Colony): boolean
}

class RoverBreakdownEmergency extends Emergency {
    - damagedRover: ExplorationRover
    + handle(colony: Colony): boolean
}

class MedicalEmergency extends Emergency {
    - patient: Human
    - treatmentFacility: Facility
    + handle(colony: Colony): boolean
}

' --- RELATIONSHIPS ---
' Composition (Colony strictly owns PrintManager)
Colony *-- "1" PrintManager : owns >

' Aggregation (Colony aggregates Agents and Facilities)
Colony o-- "0..*" Agent : aggregates >
Colony o-- "1..*" Facility : aggregates >

' Associations
Colony --> "0..1" Mission : activeMission >
Colony --> "0..*" Mission : pastMissions >
Colony --> "0..*" Emergency : pastEmergencies >
Colony --> "1" Environment : currentCondition >

Facility o-- "0..*" Equipment : houses >
Mission --> "0..*" Agent : assignedAgents >
Emergency --> "0..*" Agent : responders >

RepairMission --> "0..1" Facility : targets >
RepairMission --> "0..1" Equipment : repairs >
ResearchMission --> "1" Laboratory : conductsIn >
OxygenLeakEmergency --> "1" Habitat : occursIn >
FireEmergency --> "1" Facility : damages >
RoverBreakdownEmergency --> "1" ExplorationRover : stranding >
MedicalEmergency --> "1" Human : treats >
MedicalEmergency --> "1" Facility : locatedAt >

@enduml
